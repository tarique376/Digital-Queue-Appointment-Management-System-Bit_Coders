# Neon console -> Connection details -> pooled connection string. Keep sslmode=require.
DATABASE_URL="postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_POOLED_HOST/YOUR_DATABASE?sslmode=require"
APP_URL=http://localhost:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
# Required for db:seed. Use a unique password with at least 12 characters.
SEED_PASSWORD=
# Optional email transport. In-app notifications always work.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=QueueFlow <notifications@example.com>
